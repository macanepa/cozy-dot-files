/*******************************************************
 * ROFI theme colors — matched to the pywal green/sage palette
 * (was a hardcoded Arc red/blue theme; remapped to the theme).
 * Palette: #0f1212 bg, #455B4C #526852 #546E6C #607767 #788E7D accents, #b2bebc fg
 *******************************************************/
* {
    selected-normal-foreground:  rgba ( 255, 255, 255, 100 % );
    foreground:                  rgba ( 178, 190, 188, 100 % );  /* #b2bebc */
    normal-foreground:           @foreground;
    alternate-normal-background: rgba ( 15, 18, 18, 1 % );
    red:                         rgba ( 220, 50, 47, 100 % );
    selected-urgent-foreground:  rgba ( 249, 249, 249, 100 % );
    blue:                        rgba ( 96, 119, 103, 100 % );   /* #607767 */
    urgent-foreground:           rgba ( 204, 102, 102, 100 % );
    alternate-urgent-background: rgba ( 69, 91, 76, 90 % );      /* #455B4C */
    active-foreground:           rgba ( 120, 142, 125, 100 % );  /* #788E7D */
    lightbg:                     rgba ( 238, 232, 213, 100 % );
    selected-active-foreground:  rgba ( 249, 249, 249, 100 % );
    alternate-active-background: rgba ( 15, 18, 18, 88 % );
    background:                  rgba ( 15, 18, 18, 88 % );      /* #0f1212 */
    alternate-normal-foreground: @foreground;
    normal-background:           rgba ( 15, 18, 18, 1 % );
    lightfg:                     rgba ( 88, 104, 117, 100 % );
    selected-normal-background:  rgba ( 82, 104, 82, 100 % );    /* #526852 — verde, antes era rojo */
    border-color:                rgba ( 69, 91, 76, 100 % );     /* #455B4C */
    spacing:                     20;
    separatorcolor:              rgba ( 69, 91, 76, 60 % );      /* #455B4C */
    urgent-background:           rgba ( 69, 91, 76, 15 % );
    selected-urgent-background:  rgba ( 84, 110, 108, 100 % );   /* #546E6C */
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            rgba ( 0, 0, 0, 0 % );
    alternate-active-foreground: @active-foreground;
    active-background:           rgba ( 82, 104, 82, 17 % );
    selected-active-background:  rgba ( 69, 91, 76, 100 % );     /* #455B4C */
}
