/* Generated by qtile apply_theme — overwritten on every theme switch. */
* {
    selected-normal-foreground:  rgba ( 236, 209, 177, 100 % );
    foreground:                  rgba ( 236, 209, 177, 100 % );
    normal-foreground:           @foreground;
    alternate-normal-background: rgba ( 22, 15, 6, 0 % );
    red:                         rgba ( 220, 50, 47, 100 % );
    selected-urgent-foreground:  rgba ( 22, 15, 6, 100 % );
    blue:                        rgba ( 160, 94, 13, 100 % );
    urgent-foreground:           rgba ( 240, 166, 76, 100 % );
    alternate-urgent-background: rgba ( 46, 32, 15, 40 % );
    active-foreground:           rgba ( 227, 189, 143, 100 % );
    lightbg:                     rgba ( 236, 209, 177, 100 % );
    selected-active-foreground:  rgba ( 236, 209, 177, 100 % );
    alternate-active-background: rgba ( 160, 94, 13, 17 % );
    background:                  rgba ( 22, 15, 6, 92 % );
    alternate-normal-foreground: @foreground;
    normal-background:           rgba ( 22, 15, 6, 0 % );
    lightfg:                     rgba ( 191, 134, 64, 100 % );
    selected-normal-background:  rgba ( 160, 94, 13, 100 % );
    border-color:                rgba ( 160, 94, 13, 100 % );
    spacing:                     20;
    separatorcolor:              rgba ( 160, 94, 13, 60 % );
    urgent-background:           rgba ( 46, 32, 15, 40 % );
    selected-urgent-background:  rgba ( 240, 166, 76, 100 % );
    alternate-urgent-foreground: @urgent-foreground;
    background-color:            rgba ( 0, 0, 0, 0 % );
    alternate-active-foreground: @active-foreground;
    active-background:           rgba ( 160, 94, 13, 17 % );
    selected-active-background:  rgba ( 160, 94, 13, 100 % );
}
